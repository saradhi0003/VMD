# ───────────── Supabase ─────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# ───────────── App ─────────────
# Base URL used for invite/auth redirects. Set to your domain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# MFA is OFF unless this is exactly "true". Turn on ONLY after enabling TOTP in the
# Supabase dashboard (Authentication → MFA), else logins bounce to an erroring enrol page.
MFA_ENFORCED="false"

# ───────────── Open-source LLM (Colab / any OpenAI-compatible server) ─────────────
# Free path: run infra/colab/vayumukhi-llm-server.ipynb, paste its output here.
# When LLM_BASE_URL is set it WINS over ANTHROPIC_API_KEY. With neither, scan/voice
# fall back to the offline regex parser and the app still works.
# The Colab tunnel URL changes every session — re-paste it each time.
LLM_PROVIDER=""                 # "" (auto) | "openai-compat" | "anthropic"
LLM_BASE_URL=""                 # e.g. https://xxxx.trycloudflare.com/v1  — must end in /v1
LLM_API_KEY=""                  # the token the notebook printed
LLM_MODEL_AGENT="Qwen/Qwen2.5-VL-7B-Instruct-AWQ"
LLM_MODEL_FAST="Qwen/Qwen2.5-VL-7B-Instruct-AWQ"
LLM_TIMEOUT_MS="120000"         # a free T4 needs 30-90s for a full-page scan

# ───────────── Claude (Anthropic) ─────────────
# Optional fallback — costs money. Leave blank to run purely on the Colab server.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_AGENT="claude-sonnet-4-6"
ANTHROPIC_MODEL_FAST="claude-haiku-4-5-20251001"

# ───────────── SMTP (admin "access requested" notifications) ─────────────
# LAYER 2 ONLY. The auth emails themselves (magic links, invites) are configured
# in the Supabase dashboard → Auth → Emails → SMTP settings, NOT here.
# Best-effort: leave blank and signups still work — the request shows up in the
# owner's Team panel, which is the source of truth.
# Gmail: use an App Password (not your account password), host smtp.gmail.com, port 465.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Always-on fallback recipient, in addition to every active farm owner.
ADMIN_EMAIL=""

# ───────────── Inngest ─────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ───────────── WhatsApp (Meta Cloud API) ─────────────
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ───────────── Misc ─────────────
NODE_ENV="development"
FARM_TIMEZONE="Asia/Kolkata"
OWNER_WHATSAPP_NUMBER="+919876543210"
